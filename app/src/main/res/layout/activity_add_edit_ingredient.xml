<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".AddEditIngredientActivity"
    android:background="@color/gotem_black">

    <TextView
        android:id="@+id/textAddIngredientTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ADD TO YOUR STASH"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/gotem_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textAddIngredientSubTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:textSize="16sp"
        android:textColor="@color/gotem_light_grey"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/textAddIngredientTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/editIngredientName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Ingredient name"
        android:inputType="textCapWords"
        android:layout_marginTop="24dp"
        android:textColor="@color/gotem_white"
        android:textColorHint="@color/gotem_mid_grey"
        android:backgroundTint="@color/gotem_blue"
        app:layout_constraintTop_toBottomOf="@id/textAddIngredientSubTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/editIngredientQuantity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Quantity"
        android:inputType="numberDecimal"
        android:layout_marginTop="16dp"
        android:textColor="@color/gotem_white"
        android:textColorHint="@color/gotem_mid_grey"
        android:backgroundTint="@color/gotem_blue"
        app:layout_constraintTop_toBottomOf="@id/editIngredientName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Spinner
        android:id="@+id/spinnerMeasurementUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/gotem_blue"
        app:layout_constraintTop_toBottomOf="@id/editIngredientQuantity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Spinner
        android:id="@+id/spinnerIngredientCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/gotem_blue"
        app:layout_constraintTop_toBottomOf="@id/spinnerMeasurementUnit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/editExpiryDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Expiry date (Optional)"
        android:focusable="false"
        android:clickable="true"
        android:focusableInTouchMode="false"
        android:layout_marginTop="16dp"
        android:textColor="@color/gotem_white"
        android:textColorHint="@color/gotem_mid_grey"
        android:backgroundTint="@color/gotem_blue"
        app:layout_constraintTop_toBottomOf="@id/spinnerIngredientCategory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/buttonSaveIngredient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SAVE INGREDIENTS"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/gotem_red"
        android:textColor="@color/gotem_white"
        app:layout_constraintTop_toBottomOf="@id/editExpiryDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/buttonDeleteIngredient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="DELETE INGREDIENT"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/gotem_red_dark"
        android:textColor="@color/gotem_white"
        app:layout_constraintTop_toBottomOf="@id/buttonSaveIngredient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>