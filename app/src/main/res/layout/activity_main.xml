<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background = "@color/gotem_black">

    <TextView
        android:id="@+id/textHomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GOT 'EM RECIPES"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/gotem_white"
        android:letterSpacing="0.04"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    
    <TextView
        android:id="@+id/textHomeTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Food you got, Meals you want"
        android:textSize="16sp"
        android:textColor="@color/gotem_light_grey"
        app:layout_constraintTop_toBottomOf="@+id/textHomeTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/cardPantry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/home_card_background"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintTop_toBottomOf="@+id/textHomeTagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <TextView
        android:id="@+id/textPantryOverview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="YOUR PANTRY"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/gotem_white"
        />

    <TextView
        android:id="@+id/textHomePantryCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text = "0 pantry items"
        android:textSize="16sp"
        android:textColor="@color/gotem_light_grey"
       />

    <Button
        android:id="@+id/buttonHomePantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="OPEN PANTRY"
        android:textColor="@color/gotem_white"
        android:backgroundTint="@color/gotem_red"/>


    </LinearLayout>

    <LinearLayout
        android:id = "@+id/cardSuggestions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/home_card_background"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintTop_toBottomOf="@+id/cardPantry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <TextView
        android:id="@+id/textTryTheseToday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="TRY THESE TODAY"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/gotem_white"
        />

    <TextView
        android:id="@+id/textHomeSuggestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Add pantry ingredients to unluck therecipe suggestions."
        android:textSize="15sp"
        android:textColor="@color/gotem_light_grey"
       />
    <Button
        android:id="@+id/buttonHomeRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="VIEW SUGGESTED RECIPES"
        android:textColor="@color/gotem_white"
        android:backgroundTint="@color/gotem_red"
    />
    <Button
        android:id="@+id/buttonHomeAllRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="VIEW ALL THE RECIPES"
        android:textStyle="bold"
        android:backgroundTint="@color/gotem_blue"
        android:textColor="@color/gotem_white"/>
    </LinearLayout>

    <Button
        android:id="@+id/buttonHomeSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SETTINGS"
        android:textColor="@color/gotem_white"
        android:backgroundTint="@color/gotem_blue"
        app:layout_constraintTop_toBottomOf="@id/cardSuggestions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>
