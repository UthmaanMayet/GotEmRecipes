<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/gotem_black" >

    <Button
        android:id="@+id/buttonAllRecipesBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BACK"
        android:backgroundTint="@color/gotem_blue"
        android:textColor="@color/gotem_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textAllRecipesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="ALL RECIPES"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/gotem_white"
        app:layout_constraintTop_toBottomOf="@id/buttonAllRecipesBack"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textAllRecipesSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Browse the full GOT 'EM COLLECTION"
        android:textSize="15sp"
        android:textColor="@color/gotem_light_grey"
        app:layout_constraintTop_toBottomOf="@id/textAllRecipesTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAllRecipes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/textAllRecipesSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>